COMPOSE_PROJECT_NAME=tfs-agentic

TFS_NBI_URL=http://nbiservice.tfs.svc.cluster.local:8080
TFS_NBI_PREFIX=/tfs-api
TFS_NBI_USER=admin
TFS_NBI_PASS=admin

LLM_PROVIDER=openai
LLM_MODEL=gpt-4o-mini
OPENAI_API_KEY=paste-your-openai-api-key-here
LLM_TEMPERATURE=0.1

# Select one provider profile by setting LLM_PROVIDER + LLM_MODEL
#
# Ollama (local Qwen)
#   LLM_PROVIDER=ollama
#   LLM_MODEL=qwen2.5:7b-instruct
#   OLLAMA_BASE_URL=http://ollama:11434
#
# OpenAI (ChatGPT)
#   LLM_PROVIDER=openai
#   LLM_MODEL=gpt-4o-mini
#   OPENAI_API_KEY=sk-...
#   OPENAI_BASE_URL=    # optional, only for compatible gateways/proxies
#
# Anthropic (Claude)
#   LLM_PROVIDER=anthropic
#   LLM_MODEL=claude-3-5-sonnet-latest
#   ANTHROPIC_API_KEY=sk-ant-...

AGENT_API_PORT=8800
# Comma-separated peer agent base URLs for cross-domain A2A workflows. use private ipv4 address of the vm where the other ai agent runs
A2A_PEERS=http://172.31.44.44/agentic
TFS_MCP_PORT=3002
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
AGENT_VERBOSE=false
AGENT_MAX_ITERATIONS=15
AGENT_EXPOSE_RAW_MCP_TOOLS=false
MCP_HARD_RESPONSE_CAP=20000

K8S_NAMESPACE=tfs-agentic
K8S_IMAGE_LOAD_MODE=registry
K8S_IMAGE_REGISTRY=localhost:32000
K8S_MCP_SERVERS=http://tfs-mcp-server:3002/sse
      "title": "A2A task and message rate",
      "type": "timeseries",
      "targets": [{"expr": "sum by (path) (rate(tfs_agent_http_requests_total{path=~\"/a2a/(task|message)\"}[5m]))", "legendFormat": "{{path}}", "refId": "A"}]

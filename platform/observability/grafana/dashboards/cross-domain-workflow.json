    {
      "title": "A2A task failures",
      "type": "timeseries",
      "targets": [{"expr": "sum(rate(tfs_agent_http_requests_total{path=\"/a2a/task\",status=~\"5..\"}[5m]))", "legendFormat": "task 5xx/s", "refId": "A"}]
    },
    {
      "title": "A2A p95 latency",
      "type": "timeseries",
      "targets": [{"expr": "histogram_quantile(0.95, sum by (le, path) (rate(tfs_agent_http_request_duration_seconds_bucket{path=~\"/a2a/(task|message)\"}[5m])))", "legendFormat": "{{path}}", "refId": "A"}]
    }
  ],
